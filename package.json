{
  "name": "@iantri/pi-sandbox-aware",
  "version": "0.1.0",
  "description": "Make pi aware when it is running inside a macOS sandbox",
  "type": "module",
  "license": "MIT",
  "author": "iantri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iantri/pi-sandbox-aware.git"
  },
  "homepage": "https://github.com/iantri/pi-sandbox-aware",
  "bugs": {
    "url": "https://github.com/iantri/pi-sandbox-aware/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sandbox"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/sandbox-aware/index.ts"
    ]
  },
  "dependencies": {
    "koffi": "3.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:native": "node --import tsx --test verification/native.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.6.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
